# ============================================================
# Transport
# ============================================================
# stdio | http
MCP_TRANSPORT=stdio
# HTTP transport (only used when MCP_TRANSPORT=http)
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# ============================================================
# Bitbucket API
# ============================================================
BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
# Default workspace used when a tool call omits "workspace" (optional)
BITBUCKET_DEFAULT_WORKSPACE=

# ============================================================
# Authentication
# ------------------------------------------------------------
# If BITBUCKET_ACCESS_TOKEN is set, the Bearer TokenProvider is used.
# Otherwise the OAuth 2.0 Authorization Code flow is used with the
# client id/secret below.
# ============================================================
BITBUCKET_ACCESS_TOKEN=

# Required when using a Bitbucket API token (starts with ATATT).
# Use your Atlassian account email from Bitbucket → Personal settings → Email aliases.
BITBUCKET_EMAIL=

# Alternative to BITBUCKET_EMAIL for legacy app passwords (deprecated June 2026).
BITBUCKET_USERNAME=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
BITBUCKET_AUTHORIZE_URL=https://bitbucket.org/site/oauth2/authorize
BITBUCKET_TOKEN_URL=https://bitbucket.org/site/oauth2/access_token

# ============================================================
# Token store (OAuth persistence)
# file | memory | redis
# ============================================================
TOKEN_STORE=file
TOKEN_STORE_FILE_PATH=.tokens.json

# ============================================================
# Cache
# memory | redis
# ============================================================
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300

# Redis connection (used when CACHE_PROVIDER=redis or TOKEN_STORE=redis)
REDIS_URL=redis://localhost:6379

# ============================================================
# LLM provider
# openai | anthropic | gemini | bedrock
# ============================================================
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# ============================================================
# Large PR chunking
# ============================================================
MAX_FILES_PER_CHUNK=50
MAX_DIFF_LINES_PER_CHUNK=5000

# ============================================================
# Rate limiting / retry
# ============================================================
RATE_LIMIT_MAX_RETRIES=5
RATE_LIMIT_BASE_DELAY_MS=500
RATE_LIMIT_MAX_DELAY_MS=20000

# ============================================================
# Observability / logging
# ============================================================
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
